# Public site URL used for SEO, canonical links, sitemap, RSS, and structured data.
NEXT_PUBLIC_SITE_URL=https://thedigitalplant.com

# Optional Google Analytics measurement ID.
NEXT_PUBLIC_GA_ID=

# Optional newsletter provider integration.
# For launch, keep empty. Later connect Beehiiv, ConvertKit, Mailchimp, Buttondown, etc.
NEWSLETTER_PROVIDER=
NEWSLETTER_API_KEY=
NEWSLETTER_PUBLICATION_ID=

# Optional contact email provider integration.
# For launch, keep empty. Later connect Resend, SendGrid, Mailgun, etc.
CONTACT_PROVIDER=
CONTACT_API_KEY=
CONTACT_TO_EMAIL=hello@thedigitalplant.com
CONTACT_FROM_EMAIL=website@thedigitalplant.com
